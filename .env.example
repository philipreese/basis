# Every variable the system actually reads, and nothing it doesn't (#285).
# Copy to .env and uncomment what you need. Secrets (topics, tokens) are
# never committed; the bot's paper PASSWORD lives only in IBC's local
# config.ini (scripts/setup-ibc.ps1) — never in any .env.

# --- Database ---------------------------------------------------------------
# DATABASE_URL=sqlite+aiosqlite:///basis.db

# --- Push notifications (ntfy.sh) -------------------------------------------
# Both topics are SECRETS — pick unguessable strings.
# NTFY_TOPIC=basis-evening-xxxxxx          # digests, alerts, fill pushes
# NTFY_COMMAND_TOPIC=basis-cmd-xxxxxx      # remote HALT channel (HALT only; RESUME is console-only)
# NTFY_SERVER=https://ntfy.sh

# --- Interactive Brokers (sole broker, ADR-0007) ----------------------------
# IBKR_GATEWAY_HOST=127.0.0.1
# IBKR_GATEWAY_PORT=4002
# IBKR_CLIENT_ID=17            # executor's broker session
# IBKR_DATA_CLIENT_ID=18       # market_data's transient fetches — must differ from 17 (#198)
# IBKR_TRADING_MODE=paper      # paper|live — selects the mode AND its database file (#204).
                               # Each database is stamped; a mode-mismatched open refuses hard.
                               # The paper executor refuses to run at all in live mode.

# --- Gateway start-on-demand via IBC (#68) ----------------------------------
# IBC_START_SCRIPT=C:\IBC\StartGateway.bat

# --- Executor (Live), #1065 — these go in `.env.live`, NEVER in this file ----
# The live pixi tasks set BASIS_ENV_OVERLAY=.env.live: that file is loaded on
# top of .env and wins for every name it sets. A missing .env.live refuses.
# Keep IBKR_TRADING_MODE=paper (or unset) here; .env.live sets it to live.
#   IBKR_TRADING_MODE=live
#   IBKR_LIVE_ACCOUNT_ID=           # the live IRA account id (secret-ish; never logged)
#   IBKR_LIVE_GATEWAY_PORT=4001     # the live Gateway's API port — must differ from the paper port
#   IBKR_GATEWAY_PORT=4001          # same value: market-data fetches in the live process use it
#   IBC_LIVE_START_SCRIPT=C:\IBC\StartGatewayLive.bat   # its own IBC config ini, the live API login
#   IBC_LIVE_INI=C:\IBC\live\config.ini   # #1098: the live IBC ini path, exactly as the start script names it.
#                                   # Paper Gateway teardowns read it (and IBC_LIVE_START_SCRIPT) from
#                                   # .env.live to leave the persistent live Gateway running.
#   IBC_START_SCRIPT=C:\IBC\StartGatewayLive.bat        # optional, same value (log-dir heuristics)
#   IBC_LOG_DIR=C:\IBC\LogsLive     # optional
#   BASIS_LIVE_STAKE_B36=           # #1098: the book's PRIVATE real-money stake, in dollars. Read only in
#                                   # live mode; never put it in seeds.py (the repo is public). The grant
#                                   # pins it: changing it later halts the book until a step-up grant.
#   IBKR_LIVE_ARM=TRANSMIT          # the SECOND key. Absent or any other value = DRY RUN.
# IBKR_ACCOUNT_ID is not read by any code (it predates #1065) and is not the live guard.

# --- Weekly Flex audit (#74) -------------------------------------------------
# Query + token MUST be created while logged into Client Portal as the PAPER
# user — a live-login query never sees the paper account.
# IBKR_FLEX_TOKEN=xxxxxxxxxxxxxxxx         # secret
# IBKR_FLEX_QUERY_ID=123456
# IBKR_FLEX_BASE=                          # endpoint override; rarely needed

# --- Executor ops ------------------------------------------------------------
# HALT_FILE=HALT                                   # sentinel: existence halts all entries
# EXECUTOR_HEARTBEAT_FILE=executor_heartbeat.json  # dead-man watchdog reads this
# BASIS_LOG_DIR=logs                               # rotating file logs per entrypoint (#271)
# BASIS_LOCK_DIR=.                                 # executor run-lock file (#275)
# DB_BACKUP_DIR=C:\Users\you\OneDrive\basis-db-backups  # nightly DB copies, 7 rotations (#207)

# --- Frontend ---------------------------------------------------------------
# CORS_ORIGINS=http://localhost:5173
# VITE_EXTRA_ALLOWED_HOST=my-machine.my-tailnet.ts.net  # extra Host the Vite dev server accepts (e.g. Tailscale Serve proxy for remote console access); set in the environment that launches `npm run dev`, keep the real value out of the repo
