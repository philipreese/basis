# Optional: comma-separated allowed browser origins (default: local Vite dev server)
# CORS_ORIGINS=http://localhost:5173

# Nightly Operator digest (ntfy.sh push). Topic is a secret — pick something unguessable.
# NTFY_TOPIC=basis-evening-xxxxxx
# NTFY_SERVER=https://ntfy.sh

# Interactive Brokers — sole broker for market data and (future) execution
# (ADR-0007). Set up by the IBKR signup wizard; market data needs IB Gateway
# running and logged in (paper). Passwords are never stored here — the Gateway
# handles authentication interactively.
# IBKR_ACCOUNT_ID=U1234567
# IBKR_PAPER_USERNAME=your_paper_username
# IBKR_PAPER_ACCOUNT_ID=DU1234567
# IBKR_GATEWAY_HOST=127.0.0.1
# IBKR_GATEWAY_PORT=4002
# IBKR_CLIENT_ID=17
# IBKR_TRADING_MODE=paper
