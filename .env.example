# Alpaca — market data only (SPY/VIX telemetry, option quote refresh)
ALPACA_API_KEY_ID=your_actual_paper_key_here
ALPACA_SECRET_KEY=your_actual_paper_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# Optional: comma-separated allowed browser origins (default: local Vite dev server)
# CORS_ORIGINS=http://localhost:5173

# Nightly Operator digest (ntfy.sh push). Topic is a secret — pick something unguessable.
# NTFY_TOPIC=basis-evening-xxxxxx
# NTFY_SERVER=https://ntfy.sh

# Interactive Brokers — execution broker (ADR-0007). Set up by the IBKR signup
# wizard; used by the Executor phases (#32). Passwords are never stored here —
# IB Gateway handles authentication interactively.
# IBKR_ACCOUNT_ID=U1234567
# IBKR_PAPER_USERNAME=your_paper_username
# IBKR_PAPER_ACCOUNT_ID=DU1234567
# IBKR_GATEWAY_PORT=4002
# IBKR_TRADING_MODE=paper
